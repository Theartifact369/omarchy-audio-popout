#!/usr/bin/env python3
# omarchy-eq — btop-styled EasyEffects EQ TUI for Omarchy.
# Colors come from the current Omarchy theme (~/.local/state/omarchy/current/
# theme/colors.toml), so wallpaper-derived themes restyle it automatically.
# Bands come from ~/.config/easyeffects/presets/output/*.json; saving one
# preset from the EasyEffects GUI once bootstraps this. Applies via
# `easyeffects -l <name>`.
# ponytail: preset-file round-trip (no live state API in EasyEffects 8);
# per-band live writes need an EE IPC, add if upstream ships one.
import curses, json, math, os, select, subprocess, sys, tempfile, tomllib

HOME = os.path.expanduser("~")
THEME_FILE = f"{HOME}/.local/state/omarchy/current/theme/colors.toml"
PRESET_DIR = f"{HOME}/.config/easyeffects/presets/output"

# ---------------------------------------------------------------- theme ----

def hex_to_256(hx):
    """Nearest xterm-256 index for #rrggbb (6x6x6 cube + grays)."""
    hx = hx.lstrip("#")
    if len(hx) != 6:
        return None
    try:
        r, g, b = (int(hx[i:i+2], 16) for i in (0, 2, 4))
    except ValueError:
        return None
    gray = (r + g + b) / 3
    if max(r, g, b) - min(r, g, b) < 8 and abs(gray - round(gray / 10) * 10) < 6:
        return 232 + min(23, round(gray / 10))  # gray ramp
    def cube(v):  # 0-255 -> 0-5
        return min(5, max(0, (v - 35) // 40))
    return 16 + cube(r) * 36 + cube(g) * 6 + cube(b)

def load_theme():
    colors = {}
    try:
        with open(THEME_FILE, "rb") as f:
            data = tomllib.load(f)
        for key in ("background", "foreground", "accent", "muted", "red",
                    "yellow", "green", "blue", "darker_background"):
            v = hex_to_256(str(data.get(key, "")))
            if v is not None:
                colors[key] = v
    except (OSError, tomllib.TOMLDecodeError):
        pass
    colors.setdefault("background", 234)
    colors.setdefault("foreground", 252)
    colors.setdefault("accent", 39)
    colors.setdefault("muted", 240)
    colors.setdefault("red", 203)
    colors.setdefault("yellow", 214)
    colors.setdefault("green", 114)
    colors.setdefault("blue", 39)
    colors.setdefault("darker_background", 236)
    return colors

# --------------------------------------------------------------- presets ---

def presets():
    try:
        return sorted(f[:-5] for f in os.listdir(PRESET_DIR) if f.endswith(".json"))
    except OSError:
        return []

def load_preset(name):
    with open(f"{PRESET_DIR}/{name}.json", encoding="utf-8") as f:
        data = json.load(f)
    eq = data["output"]["effects"]["equalizer"]
    bands = eq.get("bands")
    if not isinstance(bands, list) or not bands:
        raise ValueError(f"preset '{name}' has no equalizer bands")
    return data

def band_freq(b):
    f = b.get("frequency", 0)
    return f"{f/1000:g}k" if f >= 1000 else f"{f:g}"

def save_preset(name, data):
    with open(f"{PRESET_DIR}/{name}.json", "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2)
        f.write("\n")

def run_ee(*args):
    return subprocess.run(["easyeffects", *args], capture_output=True, text=True)

# --------------------------------------------------------------- cava ------

class Spectrum:
    """Raw cava output -> 0..1 levels, one line per frame."""

    def __init__(self, bars):
        self.bars = bars
        self.levels = [0.0] * bars
        conf = "\n".join([
            "[general]", f"bars = {bars}", "framerate = 60", "autosens = 1", "",
            "[input]", "method = pulse", "",
            "[output]", "method = raw", "raw_target = /dev/stdout",
            "data_format = ascii", "ascii_max_range = 1000",
            "bar_delimiter = 32", "frame_delimiter = 10", "",
        ])
        fd, path = tempfile.mkstemp(suffix=".conf", prefix="omarchy-eq-")
        with os.fdopen(fd, "w") as f:
            f.write(conf)
        self.proc = subprocess.Popen(
            ["cava", "-p", path], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        os.unlink(path)
        os.set_blocking(self.proc.stdout.fileno(), False)

    def poll(self):
        try:
            chunk = os.read(self.proc.stdout.fileno(), 65536)
        except (BlockingIOError, OSError):
            return
        if not chunk:
            return
        line = chunk.decode("ascii", "replace").strip().rsplit("\n", 1)[-1]
        parts = line.split()
        if len(parts) < 2:
            return
        self.levels = [min(1.0, float(p) / 1000) for p in parts[:self.bars]]
        self.levels += [0.0] * (self.bars - len(self.levels))

    def stop(self):
        self.proc.kill()

# ------------------------------------------------------------------ ui -----

PAIRS = {}  # role -> curses pair id

def pair(role, fg, bg):
    pid = len(PAIRS) + 1
    curses.init_pair(pid, fg, bg)
    PAIRS[role] = pid

def level_color(v):
    if v < 0.4:
        return "blue"
    if v < 0.7:
        return "green"
    if v < 0.9:
        return "yellow"
    return "red"

def draw_box(scr, y, x, h, w, title, theme):
    attr = curses.color_pair(PAIRS["muted"])
    scr.addstr(y, x, "┌" + "─" * (w - 2) + "┐", attr)
    if title:
        scr.addstr(y, x + 2, f" {title} ", curses.color_pair(PAIRS["accent"]))
    for i in range(1, h - 1):
        try:
            scr.addstr(y + i, x, "│", attr)
            scr.addstr(y + i, x + w - 1, "│", attr)
        except curses.error:
            pass
    try:
        scr.addstr(y + h - 1, x, "└" + "─" * (w - 2) + "┘", attr)
    except curses.error:
        pass

def main(stdscr):
    theme = load_theme()
    curses.start_color()
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(33)
    pair("fg", theme["foreground"], theme["background"])
    pair("accent", theme["accent"], theme["background"])
    pair("muted", theme["muted"], theme["background"])
    pair("bar", theme["darker_background"], theme["background"])
    for role in ("red", "yellow", "green", "blue"):
        pair(role, theme[role], theme["background"])
    stdscr.bkgd(" ", curses.color_pair(PAIRS["fg"]))

    names = presets()
    idx = 0
    data = bands = None
    sel = 0
    status = ""
    if names:
        data = load_preset(names[idx])
        bands = data["output"]["effects"]["equalizer"]["bands"]
    else:
        status = "No presets. Save one from the EasyEffects GUI first."
    spec = None

    while True:
        h, w = stdscr.getmaxyx()
        if spec is None or spec.bars != max(8, w - 24):
            if spec:
                spec.stop()
            spec = Spectrum(max(8, w - 24))

        # ---- input ----
        key = stdscr.getch()
        if key in (ord("q"), 27):
            break
        elif key in (curses.KEY_LEFT, ord("h")) and bands:
            sel = (sel - 1) % len(bands)
        elif key in (curses.KEY_RIGHT, ord("l")) and bands:
            sel = (sel + 1) % len(bands)
        elif key in (curses.KEY_UP, ord("k"), ord("+")) and bands:
            bands[sel]["gain"] = min(20.0, bands[sel].get("gain", 0) + 1)
        elif key in (curses.KEY_DOWN, ord("j"), ord("-")) and bands:
            bands[sel]["gain"] = max(-20.0, bands[sel].get("gain", 0) - 1)
        elif key == ord("r") and bands:
            bands[sel]["gain"] = 0.0
        elif key == ord("n") and names:
            idx = (idx + 1) % len(names)
            data = load_preset(names[idx])
            bands = data["output"]["effects"]["equalizer"]["bands"]
            sel = 0
            status = f"Loaded {names[idx]}"
        elif key == ord("w") and data and names:
            save_preset(names[idx], data)
            r = run_ee("-l", names[idx])
            status = (f"Applied {names[idx]}" if r.returncode == 0
                      else f"apply failed: {r.stderr.strip()[:60]}")
        elif key == ord("b"):
            r = run_ee("--bypass-toggle")
            status = "Bypass toggled" if r.returncode == 0 else "bypass failed"

        spec.poll()

        # ---- draw ----
        stdscr.erase()
        head = f" omarchy-eq "
        sub = (names[idx] if names else "no preset") + (
            f"  ·  band {sel + 1}/{len(bands) or 0}" if bands else "")
        sub = sub[:w - 14]
        stdscr.addstr(0, 2, head, curses.color_pair(PAIRS["accent"]))
        stdscr.addstr(0, 14, sub, curses.color_pair(PAIRS["fg"]))

        # spectrum box (btop-style graph strip)
        box_h, box_w, box_y = 8, w - 4, 1
        draw_box(stdscr, box_y, 2, box_h, box_w, "Spectrum", theme)
        inner_w = box_w - 4
        rows = box_h - 2
        bars_n = len(spec.levels)
        width = max(1, inner_w // bars_n)
        for i, v in enumerate(spec.levels):
            col = PAIRS[level_color(v)]
            height = round(v * (rows - 1))
            x = 4 + i * width
            for row in range(height):
                try:
                    stdscr.addstr(box_y + box_h - 2 - row, x, "█" * width, col)
                except curses.error:
                    pass

        # bands box
        bands_h = h - box_h - 3 - 1
        if bands_h > 3 and bands:
            draw_box(stdscr, box_y + box_h, 2, bands_h + 1, box_w, "Equalizer bands", theme)
            bar_w = box_w - 24
            max_gain = max(1.0, max(abs(b.get("gain", 0)) for b in bands))
            for i, b in enumerate(bands):
                y = box_y + box_h + 2 + i
                if y >= h - 1:
                    break
                gain = b.get("gain", 0)
                fg = curses.color_pair(PAIRS["accent"] if i == sel else PAIRS["fg"])
                stdscr.addstr(y, 5, f"{band_freq(b):>5}", fg)
                stdscr.addstr(y, 12, f"{gain:+5.1f}dB", fg)
                mid = 19 + bar_w // 2
                stdscr.addstr(y, 19, "·" * bar_w, curses.color_pair(PAIRS["bar"]))
                span = bar_w // 2 - 1
                cells = round(gain / max_gain * span)
                if cells > 0:
                    stdscr.addstr(y, mid + 1, "■" * cells, fg)
                elif cells < 0:
                    stdscr.addstr(y, mid + cells, "■" * -cells, fg)
                stdscr.addstr(y, mid, "│", curses.color_pair(PAIRS["muted"]))

        stdscr.addstr(h - 1, 2,
            "←→ band  ↑↓ gain  r reset  n next preset  w write+apply  b bypass  q quit"
            [:w - 4], curses.color_pair(PAIRS["muted"]))
        if status:
            stdscr.addstr(h - 1, 2, status[:w - 4], curses.color_pair(PAIRS["green"]))
        stdscr.refresh()

    if spec:
        spec.stop()
    return 0

if __name__ == "__main__":
    if not os.environ.get("TERM"):
        sys.exit("omarchy-eq needs a terminal.")
    os.makedirs(tempfile.gettempdir(), exist_ok=True)
    sys.exit(curses.wrapper(main))
